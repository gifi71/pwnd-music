# Скопировать в .env и заполнить:  cp .env.example .env

# Пользователь/группа, владеющие медиафайлами на хосте (узнать: `id`)
PUID=1000
PGID=1000

TZ=Asia/Vladivostok

# Дефолты интерфейса Navidrome (для новых пользователей).
# Темы: Dark, Light, Spotify-ish, Auto и др. — список в UI: Настройки → Тема
NAVIDROME_LANGUAGE=ru
NAVIDROME_THEME=Spotify-ish

# Расписание автоскана библиотеки (cron-формат Navidrome). Пусто = выкл.
# Кавычки обязательны — значение со пробелом (иначе ломает `. ./.env`).
NAVIDROME_SCAN_SCHEDULE="@every 1h"

# Метадата артистов (фото/био). Без ключей страницы артистов будут пустыми.
# Last.fm: https://www.last.fm/api/account/create (даёт key + secret)
ND_LASTFM_APIKEY=
ND_LASTFM_SECRET=
# Spotify (лучшие фото артистов): https://developer.spotify.com/dashboard
ND_SPOTIFY_ID=
ND_SPOTIFY_SECRET=

# Публичный URL Navidrome для share-ссылок (если пробрасываешь домен наружу).
# Пусто = шаринг включён, но ссылки с внутренним адресом. Напр. https://music.example.com
NAVIDROME_SHAREURL=

# Корень всех медиа. Единый корень => hardlinks между загрузками и
# библиотекой работают (импорт в Lidarr без копирования и удвоения места).
# На Proxmox это обычно mountpoint большого диска / NFS-шары.
DATA_DIR=/srv/media

# Где живут конфиги/базы контейнеров (мало места, можно быстрый диск)
CONFIG_DIR=./config

# Аккаунт Soulseek для slskd. Если имя ещё не занято,
# сеть Soulseek зарегистрирует его при первом входе.
SLSKD_SLSK_USERNAME=changeme
SLSKD_SLSK_PASSWORD=changeme

# Админ-логин Koito-инстансов (общий для всех персональных Koito).
# Юзер создаётся автоматически при ПЕРВОМ старте с чистой базой.
KOITO_USERNAME=admin
KOITO_PASSWORD=changeme

# ── Персональный скробблинг (multi-scrobbler -> Koito-инстансы) ──
# LB_TOKEN_* — токен, который юзер вставляет в Navidrome -> Settings ->
# Personal -> Scrobble to ListenBrainz. Сгенерировать: openssl rand -hex 16
LB_TOKEN_GIFI=changeme_gifi
LB_TOKEN_AL=changeme_al

# API-ключи Koito-инстансов: после первого старта зайти в каждый Koito
# (Sign In) -> Settings -> API Keys -> скопировать сюда, перезапустить
# multi-scrobbler
KOITO_API_KEY_GIFI=changeme
KOITO_API_KEY_AL=changeme

# Maloja (углублённая статистика для gifi). MS пишет сюда параллельно с Koito.
# Пароль админки (только первый старт). API-ключ ГЕНЕРИШЬ САМ
# (openssl rand -hex 32) — он пресидится в maloja/apikeys.yml при установке,
# ходить в UI за ключом НЕ надо.
MALOJA_ADMIN_PASSWORD=changeme
MLJ_API_KEY=changeme

# Логин веб-интерфейса slskd
SLSKD_WEB_USERNAME=admin
SLSKD_WEB_PASSWORD=changeme

# API-ключ, общий для slskd и Soularr, МИНИМУМ 16 символов
# (сгенерировать: openssl rand -hex 24)
SLSKD_API_KEY=changeme_changeme_changeme

# Лимиты отдачи slskd (KiB/s, дом. интернет). Скачивание безлимит.
# ~75% аплинка, делить с qBittorrent. Slots не ставить в 0 (этикет Soulseek).
SLSKD_UPLOAD_SPEED_LIMIT=1000
SLSKD_UPLOAD_SLOTS=10
# Авто-рескан шары slskd, минуты (пусто = не рескан, только при старте).
# 720 = каждые 12ч — новые треки в библиотеке станут раздаваемыми.
SLSKD_SHARE_CACHE_RETENTION=720

# Как часто Soularr опрашивает wanted-список Lidarr, секунды
SOULARR_INTERVAL=300

# ── Enrichment (вшивание обложек + синхро-лирики, .lrc рядом) ──
# Cron-расписание контейнера обогащения (формат crontab). Кавычки обязательны.
ENRICH_SCHEDULE="0 4 * * *"
# Язык лирики по приоритету (для syncedlyrics/lrcup)
ENRICH_LYRICS_LANG=ru,en

# ── Проверка фейкового FLAC (ночной скан) ── Кавычки обязательны.
FAKEFLAC_SCHEDULE="0 5 * * *"

# ── Telegram-уведомления (фейк-FLAC, enrichment). Пусто = выкл. ──
# Бот: @BotFather -> /newbot -> токен. chat_id: написать боту и открыть
# https://api.telegram.org/bot<TOKEN>/getUpdates -> найти chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Публикуемые порты
NAVIDROME_PORT=4533
KOITO_GIFI_PORT=4110
KOITO_AL_PORT=4111
MALOJA_PORT=42010
MS_PORT=9078
LIDARR_PORT=8686
PROWLARR_PORT=9696

# ── Прокси (опционально, только для РФ; пусто = стек работает без него) ──
# Обход Cloudflare-блокировки РФ. Формат: socks5://user:pass@host:port или http://...
# Prowlarr: загрузка определений индексеров с indexers.prowlarr.com.
PROWLARR_PROXY=
# Lidarr: метадата с api.lidarr.audio (поиск артистов/альбомов). Можно тот же.
LIDARR_PROXY=
QBIT_WEBUI_PORT=8090
QBIT_TORRENT_PORT=6881
SLSKD_PORT=5030
SLSKD_LISTEN_PORT=50300
SOULARR_PORT=8265
